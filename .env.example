# --- Database (Supabase Postgres) ---
# Use the "Transaction" pooler URL from Supabase → Project Settings → Database
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Dashboard auth (single admin user) ---
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
ADMIN_EMAIL=you@example.com
# Generate hash: npx tsx scripts/hash-password.ts "your-password"
ADMIN_PASSWORD_HASH=

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Freelancer.com official API (optional) ---
# https://accounts.freelancer.com/settings/develop
FREELANCER_OAUTH_TOKEN=

# --- Upwork official API (optional; requires approved API key) ---
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=

# --- Misc ---
# Public URL of the deployed dashboard, used in Telegram links (optional)
DASHBOARD_URL=
# Set to 1 to force dry-run mode regardless of CLI args
GIGPILOT_DRY_RUN=
